# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public production URL of your app
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/menuz_db?schema=public"

# JWT_SECRET & API_SECRET_HEADER: Secret keys for JWT auth & API security
JWT_SECRET="your_jwt_secret_key_here"
API_SECRET_HEADER="your_api_secret_header_here"

# TELEGRAM_BOT_TOKEN & SUPER_ADMIN_TELEGRAM_ID for Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
SUPER_ADMIN_TELEGRAM_ID="your_telegram_chat_id_here"

# Vercel & Firebase Public Config (Optional for client-side Firebase)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
